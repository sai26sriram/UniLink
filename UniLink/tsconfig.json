{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@app/*": ["./app/*"],
      "@services/*": ["./services/*"],
      "@models/*": ["./models/*"],
      "@context/*": ["./context/*"],
      "@modules/*": ["./modules/*"],
      "@utils/*": ["./utils/*"]
    }
  }
}